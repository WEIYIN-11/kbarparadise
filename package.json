{
  "name": "練功房",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "交易模擬訓練工具 - 練功房",
  "scripts": {
    "fetch": "node scripts/fetch-data.mjs",
    "fetch:btc": "node scripts/fetch-data.mjs btc",
    "fetch:nq": "node scripts/fetch-data.mjs nq",
    "fetch:txf": "node scripts/fetch-data.mjs txf",
    "serve": "npx http-server . -p 8081 -c-1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test src/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm test",
    "test:visual": "python tools/visual-baseline/snap.py --out .snapshots/current",
    "test:smoke": "python tools/smoke-test.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
