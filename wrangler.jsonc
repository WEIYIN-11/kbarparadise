/**
 * Cloudflare Workers 設定 —— sim.ark-blueprint.com(練功房)。
 *
 * 純靜態站,沒有 build 步驟、沒有 Worker 程式碼:repo 根目錄就是站台根目錄
 * (搬家前 vercel.json 的 outputDirectory 也是 ".")。哪些檔不該上傳看
 * .assetsignore。標頭規則在 _headers。
 *
 * ⚠ 本站**不能用 `wrangler dev`** 本機預覽:資產目錄是 "." 而 wrangler 會把
 *   自己的暫存 .wrangler/ 寫進同一個目錄 → 檔案監看器看到變動 → 重載 → 再寫
 *   → 無限迴圈(2026-09-23 實測 2 分鐘內重載 786 次,請求全部掛住)。
 *   .assetsignore 擋得住上傳、擋不住監看器。要驗證就 `wrangler deploy` 到
 *   workers.dev 預覽網址看(workers_dev: true 就是為了這個)。
 */
{
  "name": "ark-tradersim",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // 正式網域(Custom Domain):wrangler deploy 會自動在 Cloudflare DNS 建/改
  // 該主機名的記錄並簽憑證,不用手動進 DNS 頁。
  // zone_name 必填:少了它 API 回 10082「Can't infer zone from route」(2026-09-23 實測)。
  "routes": [
    { "pattern": "sim.ark-blueprint.com", "custom_domain": true, "zone_name": "ark-blueprint.com" }
  ],

  "workers_dev": true
}
