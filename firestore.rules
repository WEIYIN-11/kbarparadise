rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the requester an admin?
    // Admin = their email exists in /whitelist/{email} with role == 'admin'
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.role == 'admin';
    }

    // Whitelist:
    //   - any signed-in user may check their OWN entry (for login gate)
    //   - admins may read everything and create/update/delete entries
    match /whitelist/{email} {
      allow get: if request.auth != null
                 && (request.auth.token.email.lower() == email || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // User data: only the owner can read/write their own state.
    match /users/{uid}/{path=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public share links (read-only views for coaches).
    // The `id` is a random 12-char token; anyone with the link can fetch by ID
    // but NO ONE can list/enumerate the collection.
    match /shares/{shareId} {
      allow get: if true;       // anyone with the link
      allow list: if false;     // no enumeration
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }
  }
}
